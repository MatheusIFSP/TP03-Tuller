@model IEnumerable<Produto>
@{
    ViewData["Title"] = "Produtos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Produtos</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Novo produto
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Nenhum produto cadastrado.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Html.DisplayNameFor(m => m.Nome)</th>
                        <th>@Html.DisplayNameFor(m => m.Descricao)</th>
                        <th class="text-end">@Html.DisplayNameFor(m => m.Preco)</th>
                        <th class="text-center">Estoque</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Nome</td>
                            <td class="descricao-truncada">@item.Descricao</td>
                            <td class="text-end">@item.Preco.ToString("C2")</td>
                            <td class="text-center">
                                <span class="badge @(item.QuantidadeEstoque == 0 ? "bg-danger" : item.QuantidadeEstoque < 10 ? "bg-warning text-dark" : "bg-success")">
                                    @item.QuantidadeEstoque
                                </span>
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Detalhes"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Excluir"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
